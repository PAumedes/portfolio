FROM dunglas/frankenphp:php8.3

ENV COMPOSER_ALLOW_SUPERUSER=1

# Install necessary PHP extensions using the provided helper script
RUN install-php-extensions \
    pcntl \
    pdo_mysql \
    mysqli \
    zip \
    gd \
    exif \
    redis \
    intl \
    bcmath \
    @composer

WORKDIR /var/www/html

# Ensure the working directory is owned by the non-root user.
# In development, this directory will be overlaid by a volume mount.
RUN chown -R www-data:www-data /var/www/html

USER www-data

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/up || exit 1

EXPOSE 8000

# Start Laravel's built-in server for hot-reloading in dev.
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
